  "analysis_steps": [
    {
      "name": "r_dc",
      "analysis": {
        "kind": "op",
        "args": ""
      },
      "alter": {},
      "measurements": [
        {
          "name": "t12_r_ratio",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "v(txa)/v(ya0)",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        },
        {
          "name": "t12_r_ratio_default",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "v(txc)/v(yc0)",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        }
      ]
    },
    {
      "name": "c_lo",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 1meg 1meg"
      },
      "alter": {},
      "measurements": [
        {
          "name": "t12_c_ratio",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "vecmax(imag(-v(yb0)))/vecmax(imag(-v(txb)))",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        },
        {
          "name": "t12_c_ratio_default",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "vecmax(imag(-v(yd0)))/vecmax(imag(-v(txd)))",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        }
      ]
    },
    {
      "name": "l_hi",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 10meg 10meg"
      },
      "alter": {},
      "measurements": [
        {
          "name": "t12_l_ratio",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "(vecmax(imag(v(txa)))+(vecmax(imag(v(yl0)))-vecmax(imag(v(ya0))))*(vecmax(real(v(txa)))/vecmax(real(v(ya0))))*(vecmax(real(v(txa)))/vecmax(real(v(ya0))))*(vecmax(imag(-v(yb0)))/vecmax(imag(-v(txb)))))/vecmax(imag(v(yl0)))",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        },
        {
          "name": "t12_l_ratio_default",
          "spec_row": "T-12",
          "unit": "ratio",
          "expr": "(vecmax(imag(v(txc)))+(vecmax(imag(v(yn0)))-vecmax(imag(v(yc0))))*(vecmax(real(v(txc)))/vecmax(real(v(yc0))))*(vecmax(real(v(txc)))/vecmax(real(v(yc0))))*(vecmax(imag(-v(yd0)))/vecmax(imag(-v(txd)))))/vecmax(imag(v(yn0)))",
          "limits": {
            "min": 0.99,
            "max": 1.01
          }
        }
      ]
    }
  ],
  "measurements": [],
