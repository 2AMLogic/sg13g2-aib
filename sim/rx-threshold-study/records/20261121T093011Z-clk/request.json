{
  "engine": "ngspice",
  "netlist": "tb_clk.cir",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "mos_tt",
        "sections": [
          "mos_tt",
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "mos_ss",
        "sections": [
          "mos_ss",
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      },
      {
        "name": "mos_ff",
        "sections": [
          "mos_ff",
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "mos_sf",
        "sections": [
          "mos_sf",
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "mos_fs",
        "sections": [
          "mos_fs",
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd_tx_b": [
        1.08,
        1.2,
        1.32
      ],
      "vdd_rx_b": [
        1.08,
        1.2,
        1.32
      ],
      "vdd_tx_c": [
        1.08,
        1.2,
        1.32
      ],
      "vdd_rx_c": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "2p 24n 0 5p"
  },
  "measurements": [
    {
      "name": "t02_dr_cr__b",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_dr_cr__b TRIG v(ddo0_b) VAL=0 RISE=6 TARG v(dxo_b) VAL=0 RISE=6"
    },
    {
      "name": "t02_df_cf__b",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_df_cf__b TRIG v(ddo0_b) VAL=0 FALL=6 TARG v(dxo_b) VAL=0 FALL=6"
    },
    {
      "name": "t02_cr_df__b",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_cr_df__b TRIG v(dxo_b) VAL=0 RISE=6 TARG v(ddo0_b) VAL=0 FALL=6"
    },
    {
      "name": "t02_cf_dr__b",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_cf_dr__b TRIG v(dxo_b) VAL=0 FALL=6 TARG v(ddo0_b) VAL=0 RISE=7"
    },
    {
      "name": "t02_dr_cr__c",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_dr_cr__c TRIG v(ddo0_c) VAL=0 RISE=6 TARG v(dxo_c) VAL=0 RISE=6"
    },
    {
      "name": "t02_df_cf__c",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_df_cf__c TRIG v(ddo0_c) VAL=0 FALL=6 TARG v(dxo_c) VAL=0 FALL=6"
    },
    {
      "name": "t02_cr_df__c",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_cr_df__c TRIG v(dxo_c) VAL=0 RISE=6 TARG v(ddo0_c) VAL=0 FALL=6"
    },
    {
      "name": "t02_cf_dr__c",
      "unit": "s",
      "spec_row": "T-02",
      "spice": ".meas tran t02_cf_dr__c TRIG v(dxo_c) VAL=0 FALL=6 TARG v(ddo0_c) VAL=0 RISE=7"
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "nonconvergence"
    ],
    "timeout_s": 1100,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ]
  },
  "backend": "batch",
  "batch": {
    "capacity_wait_s": 600
  }
}
