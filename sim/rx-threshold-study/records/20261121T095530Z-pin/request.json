{
  "engine": "ngspice",
  "netlist": "tb_pin.cir",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_tt"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "ss",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ss"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      },
      {
        "name": "ff",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ff"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "sf",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_sf"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "fs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_fs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      }
    ],
    "supply_v": {
      "vddio": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis_steps": [
    {
      "name": "cap_0_b",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 0,
        "Vpf_c": 0,
        "Vacp_b.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_0_b_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_b)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "cap_0_c",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 0,
        "Vpf_c": 0,
        "Vacp_c.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_0_c_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_c)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "cap_5_b",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 0.5,
        "Vpf_c": 0.5,
        "Vacp_b.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_5_b_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_b)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "cap_5_c",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 0.5,
        "Vpf_c": 0.5,
        "Vacp_c.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_5_c_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_c)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "cap_10_b",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 1,
        "Vpf_c": 1,
        "Vacp_b.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_10_b_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_b)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    },
    {
      "name": "cap_10_c",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 500meg 500meg"
      },
      "alter": {
        "Vpf_b": 1,
        "Vpf_c": 1,
        "Vacp_c.ac": 1
      },
      "measurements": [
        {
          "name": "t24_cpin_10_c_ff",
          "unit": "fF",
          "spec_row": "T-24",
          "expr": "vecmax(imag(-i(vacp_c)))/(2*pi*500e6)*1e15",
          "limits": {
            "max": 100
          }
        }
      ]
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "nonconvergence"
    ],
    "timeout_s": 60,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ]
  },
  "backend": "batch",
  "batch": {
    "capacity_wait_s": 600
  }
}
