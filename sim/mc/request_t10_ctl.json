{
  "engine": "ngspice",
  "netlist": "tb_t10_ctl.cir",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_tt_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "ss",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ss_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      },
      {
        "name": "ff",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ff_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "sf",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_sf_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "fs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_fs_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      }
    ],
    "supply_v": {
      "vddio": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "monte_carlo": {
    "n": 20,
    "seed": 4411,
    "vary": "mismatch"
  },
  "analysis_steps": [
    {
      "name": "rx_up",
      "analysis": {
        "kind": "dc",
        "args": "Vfr 0.3 0.7 0.0005"
      },
      "alter": {},
      "measurements": [
        {
          "name": "vth_frac",
          "spice": ".meas dc vth_frac WHEN v(dnorm)=0.5 RISE=1",
          "unit": "frac"
        },
        {
          "name": "vddio_v",
          "expr": "v(vddio)[0]",
          "unit": "V"
        }
      ]
    }
  ],
  "measurements": [
    {
      "name": "t10_offset_mv",
      "expr": "(rx_up.vth_frac-0.5)*rx_up.vddio_v*1000",
      "unit": "mV",
      "limits": {
        "min": -60,
        "max": 60,
        "target_sigma": 3
      }
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "nonconvergence"
    ],
    "timeout_s": 10,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ]
  },
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  }
}
