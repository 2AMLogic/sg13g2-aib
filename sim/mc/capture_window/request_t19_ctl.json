{
  "engine": "ngspice",
  "netlist": "tb_t19_ctl.cir",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_tt_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "ss",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ss_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_wcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ss"
          }
        ]
      },
      {
        "name": "ff",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_ff_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_bcs"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_ff"
          }
        ]
      },
      {
        "name": "sf",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_sf_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      },
      {
        "name": "fs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_fs_mismatch"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          {
            "lib": "libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        ]
      }
    ],
    "supply_v": {
      "vdd_rx": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "monte_carlo": {
    "n": 20,
    "seed": 4431,
    "vary": "mismatch"
  },
  "analysis_steps": [
    {
      "name": "cw",
      "analysis": {
        "kind": "tran",
        "args": "5p 204.0000n 0 20p"
      },
      "alter": {},
      "measurements": [
        {
          "name": "xs",
          "spice": ".meas tran xs FIND v(xr) WHEN v(qh)=0 FALL=1 FROM=1.5000n TO=102.0000n",
          "unit": "V"
        },
        {
          "name": "ys",
          "spice": ".meas tran ys FIND v(yr) WHEN v(qh)=0 RISE=1 FROM=102.0000n TO=204.0000n",
          "unit": "V"
        },
        {
          "name": "dr",
          "spice": ".meas tran dr TRIG v(padh) VAL=0 RISE=1 FROM=102.2000n TO=102.7000n TARG v(dh) VAL=0 RISE=1",
          "unit": "s"
        },
        {
          "name": "df",
          "spice": ".meas tran df TRIG v(padh) VAL=0 FALL=1 FROM=102.5000n TO=104.0000n TARG v(dh) VAL=0 FALL=1",
          "unit": "s"
        }
      ]
    }
  ],
  "measurements": [
    {
      "name": "t19_aperture_ps",
      "expr": "(cw.ys-cw.xs)*1000+(cw.df-cw.dr)*1e12",
      "unit": "ps",
      "limits": {
        "max": 150,
        "target_sigma": 7
      }
    },
    {
      "name": "t19_setup_ps",
      "expr": "-((cw.xs-0.005)*1000+cw.dr*1e12)",
      "unit": "ps"
    },
    {
      "name": "t19_hold_ps",
      "expr": "(cw.ys-0.005)*1000+cw.df*1e12",
      "unit": "ps"
    }
  ],
  "options": {
    "stage_model_inputs": true,
    "fail_on_diagnostic": [
      "nonconvergence"
    ],
    "timeout_s": 60,
    "keep_artifacts": false,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ]
  },
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  }
}
