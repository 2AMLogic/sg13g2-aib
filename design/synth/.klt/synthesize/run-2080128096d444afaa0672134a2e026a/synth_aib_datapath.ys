# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_aib_datapath.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog rtl/aib_tx_slice.v
read_verilog rtl/aib_rx_slice.v
read_verilog rtl/aib_datapath.v
hierarchy -check -top aib_datapath
synth -top aib_datapath
dfflibmap -liberty $PDK_ROOT/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_slow_1p08V_125C.lib
tee -q -o design/synth/.klt/synthesize/run-2080128096d444afaa0672134a2e026a/aib_datapath_abc.log abc -liberty $PDK_ROOT/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_slow_1p08V_125C.lib -constr design/synth/.klt/synthesize/run-2080128096d444afaa0672134a2e026a/aib_datapath_abc.constr -dont_use sg13g2_lgcp_1 -dont_use sg13g2_sighold -dont_use sg13g2_slgcp_1 -dont_use sg13g2_sdfbbp_1 -dont_use sg13g2_dfrbp_2
clean
setundef -zero
hilomap -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
tee -q -o design/synth/.klt/synthesize/run-2080128096d444afaa0672134a2e026a/aib_datapath_stats.json stat -liberty $PDK_ROOT/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_slow_1p08V_125C.lib -json -top aib_datapath
write_verilog -noattr design/synth/.klt/synthesize/run-2080128096d444afaa0672134a2e026a/aib_datapath_synth.v
