{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 1,
  "description": "Analog design sources for the I/O-cell partition: xschem schematics and symbols, and SPICE netlists derived by klt netlist. Sources exist and netlists are fresh; no spec row is claimed.",
  "sources": [
    "design/aib_pad_esd.sch",
    "design/aib_pad_esd.sym",
    "design/aib_tx_data.sch",
    "design/aib_tx_data.sym",
    "design/aib_rx_data.sch",
