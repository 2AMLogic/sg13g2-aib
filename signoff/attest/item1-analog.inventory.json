      "path": "design/aib_pad_esd.spice",
      "generator": "klt netlist",
      "check": {
        "argv": [
          "klt",
          "netlist",
          "--rcfile",
          "design/xschemrc",
          "design/aib_pad_esd.sch",
          "-o",
          "design/aib_pad_esd.spice",
          "--check"
        ],
        "local_only": true
      }
    },
