*.raw
*.log
*.vcd
*.vvp
__pycache__/
.DS_Store

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
# layout/pex records: the ngspice log is the evidence for each leg's outcome --
# it is the only place the failing card and ngspice's own message appear (see
# layout/pex/README.md "The two defects"), so it escapes *.log for the same
# append-only reason as sim/*/corners above.
!layout/pex/records/**/*.log
sim/build/
# sim/rtl-synth synthesis: per-record Yosys logs are committed evidence (the
# same append-only rationale as sim/*/corners above), so they escape *.log too.
!sim/rtl-synth/records/**/*.log
# sim/channel-eye: run_t16attr.sh regenerates the four T-16 attribution requests
# with gen_t16attr.py before every run, so the bench-directory copies are
# disposable output. The run's own copies stay tracked under records/.
/sim/channel-eye/request_t16attr_*.json
# cocotb/Icarus build + result artifacts (verification/)
sim_build/
results.xml
# a local klt venv, if one is made by hand: every klt invocation here runs
# ephemerally via uvx on the signoff/KLT_VERSION pin, so nothing creates this.
.venv/
